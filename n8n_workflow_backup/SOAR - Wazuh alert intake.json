    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst ctx = $('WhiteList Check').first().json;\n\nlet abuse = null, abuseReports = null, abuseCountry = '-', abuseIsp = '-', abuseUsage = '-';\nlet vtMal = null, vtSusp = null, vtTotal = null;\nconst failed = [];\n\nfor (const it of items) {\n  const j = it.json;\n  const name = j.analyzerName || j.workerName || '';\n  const r = j.report || {};\n  if (j.status !== 'Success' || !r.success) { failed.push(name); continue; }\n\n  if (name.startsWith('AbuseIPDB')) {\n    const d = (((r.full || {}).values || [])[0] || {}).data || {};\n    abuse = Number(d.abuseConfidenceScore ?? 0);\n    abuseReports = Number(d.totalReports ?? 0);\n    abuseCountry = d.countryCode || '-';\n    abuseIsp = d.isp || '-';\n    abuseUsage = d.usageType || '-';\n  } else if (name.startsWith('VirusTotal')) {\n    const s = ((r.full || {}).attributes || {}).last_analysis_stats || {};\n    vtMal = Number(s.malicious ?? 0);\n    vtSusp = Number(s.suspicious ?? 0);\n    vtTotal = Object.values(s).reduce((a, b) => a + Number(b || 0), 0);\n  }\n}\n\n// Chinh sach chan da chot\nconst reasons = [];\nif (ctx.level >= 12) reasons.push(`Wazuh level ${ctx.level} >= 12`);\nif (abuse !== null && abuse >= 50) reasons.push(`AbuseIPDB score ${abuse} >= 50`);\nif (vtMal !== null && vtMal > 0) reasons.push(`VirusTotal ${vtMal} engine báo malicious`);\nconst block = reasons.length > 0;\nconst verdict = block ? 'BLOCK' : 'MONITOR';\n\nconst analysis = [\n  '---',\n  '### Kết quả phân tích tự động (Cortex)',\n  `**AbuseIPDB:** score ${abuse ?? 'N/A'}/100, ${abuseReports ?? 'N/A'} báo cáo, quốc gia ${abuseCountry}, ISP ${abuseIsp} (${abuseUsage})`,\n  `**VirusTotal:** ${vtMal ?? 'N/A'} malicious, ${vtSusp ?? 'N/A'} suspicious / ${vtTotal ?? 'N/A'} engine`,\n  failed.length ? `**Analyzer lỗi:** ${failed.join(', ')}` : null,\n  `**Quyết định SOAR:** ${verdict} - ${block ? reasons.join('; ') : 'chưa đủ điều kiện chặn tự động'}`,\n].filter(Boolean).join('\\n\\n');\n\nconst tags = [...new Set([\n  ...(ctx.thehive_tags || []),\n  `abuseipdb:${abuse ?? 'na'}`,\n  `vt-malicious:${vtMal ?? 'na'}`,\n  `soar:${verdict.toLowerCase()}`,\n])];\n\nreturn [{\n  json: {\n    src_ip: ctx.src_ip,\n    level: ctx.level,\n    rule_id: ctx.rule_id,\n    thehive_alert_id: ctx.thehive_alert_id,\n    abuse_score: abuse,\n    abuse_reports: abuseReports,\n    vt_malicious: vtMal,\n    vt_suspicious: vtSusp,\n    block,\n    verdict,\n    reasons,\n    thehive_update: {\n      description: ctx.thehive_description + '\\n\\n' + analysis,\n      tags,\n    },\n  },\n}];"
      },
