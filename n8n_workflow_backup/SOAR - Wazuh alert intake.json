    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Lay du lieu tu node Parsing Alert (IP, level) va ket qua tao alert TheHive ($json)\nconst p = $('Parsing Alert').item.json;\nconst ip = p.src_ip;\n\n// Cac dai IP noi bo / he thong: khong phan tich, khong bao gio tu chan\nconst internal = [\n  /^10\\.10\\.99\\./,                // SOC\n  /^172\\.16\\.10\\./,               // DMZ\n  /^10\\.10\\.20\\./,                // CLIENT\n  /^192\\.168\\.210\\.(1|2|132)$/,   // host, NAT gateway VMware, WAN pfSense\n  /^127\\./,\n];\nconst isInternal = !ip || internal.some(r => r.test(ip));\n\nreturn {\n  json: {\n    src_ip: ip,\n    level: p.level,\n    rule_id: p.rule_id,\n    thehive_alert_id: $json._id,\n    thehive_tags: $json.tags,\n    thehive_description: $json.description,\n    is_internal: isInternal,\n  },\n};"
      },
      "type": "n8n-nodes-base.code",
